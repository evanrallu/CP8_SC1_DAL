{
  "name": "cineclub-reunion-cp8",
  "version": "1.0.0",
  "description": "CinéClub Réunion — API CP8 SC02 (SQL + NoSQL + Zod + DTO)",
  "main": "dist/index.js",
  "scripts": {
    "predev": "docker compose up -d --wait",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "docker compose up -d --wait",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f",
    "test:rollback": "node scripts/test-sc03.mjs rollback",
    "test:reserve": "node scripts/test-sc03.mjs reserve",
    "test:concurrent": "node scripts/test-sc03.mjs concurrent",
    "test:archive": "node scripts/test-sc03.mjs archive"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.0",
    "mysql2": "^3.9.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
